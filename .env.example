# Copy to .env and replace every "change-me" value. Never commit .env.

EIA_ENVIRONMENT=development
EIA_LOG_LEVEL=INFO

# Used by docker compose to initialise the database container.
POSTGRES_USER=eia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eia

# Used by the application. Inside docker compose the host is "postgres";
# when running the app on your machine, use "localhost".
EIA_DATABASE_URL=postgresql+asyncpg://eia:change-me@postgres:5432/eia
EIA_REDIS_URL=redis://redis:6379/0
EIA_READINESS_TIMEOUT_SECONDS=2

# Signing key for access tokens; at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EIA_JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-chars

# Embeddings: "fastembed" downloads BAAI/bge-small-en-v1.5 (about 70 MB) on first
# start. "hashing" needs no download but has no semantic understanding.
EIA_EMBEDDING_BACKEND=fastembed

# Language model for research tasks. "anthropic" needs an API key; "fake" is a
# keyless stand-in for demos that gives mechanical answers, not real reasoning.
EIA_LLM_PROVIDER=anthropic
EIA_ANTHROPIC_API_KEY=
EIA_LLM_MODEL=claude-sonnet-5-5
