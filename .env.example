# Copy to .env and replace every "change-me" value. Never commit .env.

EIA_ENVIRONMENT=development
EIA_LOG_LEVEL=INFO

# Used by docker compose to initialise the database container.
POSTGRES_USER=eia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eia

# Used by the application. Inside docker compose the host is "postgres";
# when running the app on your machine, use "localhost".
EIA_DATABASE_URL=postgresql+asyncpg://eia:change-me@postgres:5432/eia
EIA_REDIS_URL=redis://redis:6379/0
EIA_READINESS_TIMEOUT_SECONDS=2
